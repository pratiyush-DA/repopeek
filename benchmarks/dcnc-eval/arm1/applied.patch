diff --git a/backend/core/engines/mac_engine.py b/backend/core/engines/mac_engine.py
new file mode 100644
index 00000000..92b84e8f
--- /dev/null
+++ b/backend/core/engines/mac_engine.py
@@ -0,0 +1,43 @@
+"""
+MAC Address Validation Engine
+Validates IEEE 802 MAC address formats (colon- or hyphen-separated)
+"""
+
+from typing import List, Tuple
+
+from .base_engine import BaseEngine
+from ..registry import register_validator
+
+
+@register_validator("mac")
+class MACEngine(BaseEngine):
+    """
+    MAC address validation engine.
+
+    Validates:
+    - Colon-separated (00:1A:2B:3C:4D:5E)
+    - Hyphen-separated (00-1A-2B-3C-4D-5E)
+    """
+
+    @property
+    def name(self) -> str:
+        return "mac"
+
+    @property
+    def category(self) -> str:
+        return "network"
+
+    @property
+    def description(self) -> str:
+        return "Validates IEEE 802 MAC addresses (colon or hyphen separated)"
+
+    @property
+    def patterns(self) -> List[str]:
+        return [
+            r"^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$",   # 00:1A:2B:3C:4D:5E
+            r"^([0-9A-Fa-f]{2}-){5}[0-9A-Fa-f]{2}$",   # 00-1A-2B-3C-4D-5E
+        ]
+
+    def _validate_normalized(self, value: str) -> Tuple[bool, float]:
+        """MAC is valid if a pattern matched (base enforces fullmatch)."""
+        return True, 1.0
